# Modèle des secrets. Copier : cp .env.example .env, puis remplir .env (jamais commité).

# Mot de passe de la base Postgres de Rallly (openssl rand -hex 16)
RALLLY_DB_PASSWORD=

# Clé de chiffrement des sessions Rallly, 32 caractères minimum (openssl rand -hex 32)
SECRET_PASSWORD=

# --- Production uniquement (docker-compose.prod.yml) ---
DOMAIN=
ACME_EMAIL=
