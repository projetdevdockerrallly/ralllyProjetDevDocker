# Modèle des secrets. Copier : cp .env.example .env, puis remplir .env (jamais commité).

# Mot de passe de la base Postgres de Rallly (openssl rand -hex 16)
RALLLY_DB_PASSWORD=

# Clé de chiffrement des sessions Rallly, 32 caractères minimum (openssl rand -hex 32)
SECRET_PASSWORD=

# Mot de passe de la base Postgres d'Authentik (openssl rand -hex 16)
AUTHENTIK_DB_PASSWORD=

# Clé secrète d'Authentik (openssl rand -hex 50)
AUTHENTIK_SECRET_KEY=

# Mot de passe du compte admin Authentik "akadmin", appliqué au premier démarrage
AUTHENTIK_BOOTSTRAP_PASSWORD=

# Identifiants du provider OIDC "rallly" créé dans Authentik (Applications > Providers)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Production uniquement (docker-compose.prod.yml) ---
DOMAIN=
ACME_EMAIL=
